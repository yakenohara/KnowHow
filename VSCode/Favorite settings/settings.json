{
    // Markdown All in One
    "markdown.extension.print.absoluteImgPath": false,
    
    // Git
    "git.ignoreMissingGitWarning": true,

    // Better Jinja
    "files.associations": {
        "*.html": "jinja-html",
        "*.gs": "javascript",
    },
    
    // General
    "security.workspace.trust.enabled": false,
    "editor.fontFamily": "'BIZ UDGothic', Consolas, 'Courier New', monospace",
    "debug.console.fontSize" : 11,
    "editor.fontSize": 11,
    "editor.mouseWheelZoom": true,
    "files.autoGuessEncoding": true,
    "files.defaultLanguage": "markdown",
    "files.hotExit": "off",
    "markdown.preview.fontSize": 11,
    "terminal.integrated.fontSize": 11,
    "update.showReleaseNotes": false,
    "window.restoreWindows": "none",
    "workbench.list.openMode": "doubleClick",
    "workbench.startupEditor": "newUntitledFile",
    "editor.insertSpaces": true, // <- defaulst as true
    "extensions.ignoreRecommendations": true,
    "editor.copyWithSyntaxHighlighting": false,
    "chat.titleBar.openInAgentsWindow.enabled": false,
    "chat.titleBar.signIn.enabled": false,
    "markdown.copyFiles.destination": {
        "*.md": "assets/images/",
    },
    "window.commandCenter": false, // タイトルバー中央に表示される**「コマンドセンター」** を無効
    "workbench.secondarySideBar.defaultVisibility": "hidden", // Chat パネル(セカンダリサイドバー)を新しいウィンドウで自動表示するかどうか default: `visibleInWorkspace`

    // Dummy
    "dummy": 0,

}

